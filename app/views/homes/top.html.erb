<div class="container-fluid">
  <div class="container">
    <div class="column-section">
      <div class="left-column">
        <%= render 'shared/both_end_column', images: HomesHelper::LEFT_COLUMN_IMAGES %>
      </div>
      
      <div class="center-column">
        <%= image_tag "top/main.jpg", class: "center-column-image" %>
        <div class="center-column-image__overlay">
          <h1><%= HomesHelper::APP_TITLE %></h1>
          <h5>巡り会えた素敵な作品を共有するサービス</h5>
          <div class="department-selectbox">
            <select id="department-id" class="form-select">
              <% HomesHelper::DEPARTMENTS_INFORMATION.each do |information| %>
                <option value="<%= information[:department_id] %>" <%= "selected" if information[:department_id] == params[:id].to_i %>>
                  <%= information[:name] %>
                </option>
              <% end %>
            </select>
            <button id="select-department-button" type="button" class="btn btn-primary">鑑賞に進む</button>
          </div>
          <div>
            <%= link_to 'SideGalleryについて知る', about_path, class: "" %>
          </div>
        </div>
      </div>
      
      <div class="right-column">
        <%= render 'shared/both_end_column', images: HomesHelper::RIGHT_COLUMN_IMAGES %>
      </div>
    </div>
      <%= render 'shared/list_of_posts', title: "新着投稿", posts: @posts%>
  </div>
</div>
