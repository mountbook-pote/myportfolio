<div class="container-fluid">
  <div class="container">
    <div class="column-section">
      <div class="left-column">
        <%= render 'shared/homes/both_end_column', images: HomesHelper::LEFT_COLUMN_IMAGES %>
      </div>
      
      <div class="center-column">
        <%= image_tag "top/main.jpg", class: "center-column-image" %>
        <div class="center-column-image__overlay">
          <h1 class="brand-font"><%= HomesHelper::APP_TITLE %></h1>
          <div>
            <h5>巡り会えた素敵な作品を共有するサービス</h5>
            <%= render 'shared/department_selectbox' %>
          </div>
          <div class="about-space">
            <%= link_to 'SideGalleryについて知る', about_path, data: { turbolinks: false }, class: "link-white" %>
          </div>
        </div>
      </div>
      
      <div class="right-column">
        <%= render 'shared/homes/both_end_column', images: HomesHelper::RIGHT_COLUMN_IMAGES %>
      </div>
    </div>
      <%= render 'shared/list_of_posts', title: "新着投稿", posts: @posts,
        current_user_favorite_post_ids: @current_user_favorite_post_ids
      %>
  </div>
</div>
