<h1>SideGallery</h1>
<h5>その日巡り会えた素敵な作品たちを共有するサービス</h5>

<%= link_to 'SideGalleryについて知る', about_path %>

<div>
  <% HomesHelper::DEPARTMENTS_INFORMATION.each do |information| %>
    <div><%= link_to "#{information[:name]}", 
      department_path(information[:department_id]), 
      class: "btn btn-light", style:"color: black;" %>
    </div>
  <% end %>
</div>

<h1>新着投稿</h1>
<%= render 'shared/list_of_posts', posts: @posts%>
<%= link_to '投稿をもっと見る', posts_path, class: "btn btn-light", style:"color: black;" %>
