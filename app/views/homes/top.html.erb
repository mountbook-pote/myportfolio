<div class="container-fluid top-background">
  <div class="container">
    <div class="image-container">
      <div class="left-column">
        <%= render 'shared/column_images', images: HomesHelper::LEFT_COLUMN_IMAGES %>
      </div>
      
      <div class="center-column">
        <%= image_tag "top/main.jpg", class: "main-image" %>
        <div class="main-overlay">
          <h1><%= HomesHelper::APP_TITLE %></h1>
          <h5>巡り会えた素敵な作品を共有するサービス</h5>
          <div class="department-selectbox">
            <select id="department-id" class="form-select">
              <% HomesHelper::DEPARTMENTS_INFORMATION.each do |information| %>
                <option value="<%= information[:department_id] %>" <%= "selected" if information[:department_id] == params[:id].to_i %>>
                  <%= information[:name] %>
                </option>
              <% end %>
            </select>
            <button id="select-department-button" type="button" class="btn btn-primary">鑑賞に進む</button>
          </div>
          <div>
            <%= link_to 'SideGalleryについて知る', about_path, class: "" %>
          </div>
        </div>
      </div>
      
      <div class="right-column">
        <%= render 'shared/column_images', images: HomesHelper::RIGHT_COLUMN_IMAGES %>
      </div>
    </div>

    <div class="post-container">
      <h1>新着投稿</h1>
      <%= render 'shared/list_of_posts', posts: @posts%>
      <%= link_to '投稿をもっと見る', posts_path, class: "btn btn-light", style:"color: black;" %>
    </div>
  </div>
</div>
