<div class="post-section create-flame">
  <h1><%= title %></h1>

  <div class="post-container add-top-border">
    <div class="image-section">
      <%= render 'shared/posts/post_met_image', post: post %>
    </div>

    <div class="description-section">
      <div class="met-description-space">
        <%= render 'shared/posts/post_met_description', post: post %>
      </div>

      <%= form_with model: post do |f| %>
        <div class="user-space">
          <div class="user-space__create-post">
            <div>
              <%= render "shared/users/user_icon_attached", user: current_user, size: 50 %>
              <span class="link-default link-user"><%= current_user.name %></span>
            </div>

            <div>
              <%= f.label :comment, "コメント(140字以内)<span class='required-field'>*必須</span>".html_safe, 
                class: "label-comment" 
              %>
            </div>
            <div>
              <%= f.text_area :comment, placeholder: "コメントを入力", 
                autofocus: false, 
                class: "input input-comment" 
              %>
            </div>
          </div>
          <div class="form-error">
            <%= render "devise/shared/error_messages", resource: post, attribute: :comment %>
          </div>

          <% # new画面にだけ使用する要素 %>
          <% if post.new_record? %>
            <%= f.hidden_field :met_object_id, value: post.met_object.id %>
          <% end %>
        </div>
        
        <div class="submit-space">
          <div><%= f.submit "投稿", class: "btn btn-outline-secondary" %></div>
          <div><%= link_to "キャンセル", :back, class: "btn btn-outline-secondary cancel" %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
