<div class="artwork-grid">
  <% posts.each do |post| %>
    <div class="artwork-card">
      <%= link_to post.met_object.primary_image_small, target: "_blank", rel: "noopener" do %>
        <img src="<%= post.met_object.primary_image_small %>" alt="<%= post.met_object.title %>" width="300">
      <% end %>
      <h4><%= post.met_object.title %></h4>
      <p><strong>ジャンル:</strong> <%= post.met_object.department %></p>
      <p><strong>作家:</strong> <%= post.met_object.artist_display_name || '不明' %></p>
      <p><strong>制作年:</strong> <%= post.met_object.object_date.presence || '不明' %></p>
      <p><%= link_to 'メトロポリタン美術館で見る', post.met_object.object_url, target: "_blank", rel: "noopener", class: "post-button" %></p>
      <%= render "shared/user_icon_attached", user: post.user %>
      <p><strong>ユーザ名:</strong> <%= post.user.name %></p>
      <p><strong>コメント:</strong> <%= post.comment %></p>
      <p><strong>投稿日:</strong> <%= post.created_at.strftime("%Y/%m/%d %H:%M") %></p>
      <% if current_user == post.user %>
        <div><%= link_to "編集", edit_post_path(post.id) %></div>
        <div><%= link_to "削除", post, method: :delete, data: { confirm: "この投稿を削除しますか？" } %></div>
      <% end %>
    </div> 
  <% end %>
</div>
