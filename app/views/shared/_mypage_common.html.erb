<div class="mypage-section">
  <h2><%= user.name %>のマイページ</h2>
  <div><%= render "shared/user_icon_attached", user: user, size: 100 %></div>
  <div class="mypage-info-space">
    <div>アカウント作成日：<%= user.created_at.strftime("%Y/%m/%d") %></div>
    <div>投稿数：<%= user.posts.size %>件</div>
    <div>いいねした数：<%= user.favorite_posts.size %>件</div>
    <div>いいねされた数：<%= user.total_received_favorites %>件</div> 
  </div>
</div>
<div class="mypage-selects-section">
  <%= link_to user_path(user), data: { turbolinks: false }, class: "mypage-selects-section__button" do %>
    <div>
      <i class="bi bi-card-text" title="投稿"></i>
      <div>投稿</div>
    </div>
  <% end %>
  <%= link_to favorites_user_path(user), data: { turbolinks: false }, class: "mypage-selects-section__button favorite" do %>
    <div>
      <i class="bi bi-heart" title="いいね"></i>
      <div>いいね</div>
    </div>
  <% end %>
  <% if user == current_user && current_user.email != User::GUEST_USER_EMAIL %>
    <%= link_to edit_user_registration_path, data: { turbolinks: false }, class: "mypage-selects-section__button edit" do %>
      <div>
        <i class="bi bi-gear" title="設定"></i>
        <div>編集</div>
      </div>
    <% end %>
  <% end %>
</div>
