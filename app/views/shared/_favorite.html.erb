<div id="favorite_buttons_<%= post.id %>" class="favorite-buttons">
  <% if current_user %>
    <% # メモリ上で確認される %>
    <% if current_user_favorite_post_ids.include?(post.id) %>
      <%= link_to post_favorite_path(post), method: :delete, remote: true, class: "link-default" do %>
        <i class="bi bi-balloon-heart-fill" title="いいね解除"></i>
      <% end %>
    <% else %>
      <%= link_to post_favorite_path(post), method: :post, remote: true, class: "link-default" do %>
        <i class="bi bi-balloon-heart" title="いいねする"></i>
      <% end %>
    <% end %>
  <% else %>
    <%= link_to new_user_session_path(alert: 'アカウント登録もしくはログインしてください'),class: "link-default" do %>
      <i class="bi bi-balloon-heart" title="いいねする"></i>
    <% end %>
  <% end %>
  
  <span class="<%= 'change-favorite-sizecolor' if current_user && current_user_favorite_post_ids.include?(post.id) %>">
    <%= post.favorites_count if post.favorites_count > 0 %>
  </span>
</div>
