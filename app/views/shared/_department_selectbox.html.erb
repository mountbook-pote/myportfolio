<div class="department-selectbox-container">
  <select id="department-id" class="form-select">
    <% DepartmentsController::DEPARTMENT_IDS.each do |department_id, department_name| %>
      <option value="<%= department_id %>" <%= "selected" if department_id == params[:id].to_i %>>
        <%= ja_translated_name(department_name) %>
      </option>
    <% end %>
  </select>
  <button id="select-department-button" type="button" class="btn btn-primary">鑑賞する</button>
</div>
