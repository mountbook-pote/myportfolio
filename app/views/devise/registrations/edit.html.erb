<% content_for :title, "アカウント設定" %>

<div class="container">
  <div class="default-section edit">
    <h2>アカウント設定</h2>
    <div>
      <%= form_for(resource, as: resource_name, 
        url: registration_path(resource_name), html: { method: :patch, class: "form-section edit" }) do |f| 
      %>
        <div>
          <div>アイコン</div>
          <div class="icon-form">
            <%= render "shared/user_icon_attached",user: @user, size: 60 %>
            <%= f.file_field :image %>
          </div>
          <div class="form-error"><%= render "devise/shared/error_messages", resource: @user, attribute: :image %></div>
        </div>
        <div>
          <div><%= f.label :name %></div>
          <div><%= f.text_field :name, placeholder: "ユーザー名を入力", autocomplete: "name" %></div>
          <div class="form-error"><%= render "devise/shared/error_messages", resource: @user, attribute: :name %></div>
        </div>
        <div>
          <div><%= f.label :email %></div>
          <div><%= f.email_field :email, placeholder: "メールアドレスを入力", autocomplete: "email" %></div>
          <div class="form-error"><%= render "devise/shared/error_messages", resource: @user, attribute: :email %></div>
        </div>
        <div>
          <div><%= f.label :password, "新しいパスワード" %><span> ※変更する場合</span></div>
          <div><%= f.password_field :password, placeholder: "新しいパスワードを入力", autocomplete: "new-password" %></div>
          <div class="form-error"><%= render "devise/shared/error_messages", resource: @user, attribute: :password %></div>
        </div>
        <div>
          <div><%= f.label :password_confirmation, "新しいパスワード(確認用)" %><span> ※変更する場合</span></div>
          <div><%= f.password_field :password_confirmation, placeholder: "確認用パスワードを入力", autocomplete: "new-password" %></div>
          <div class="form-error"><%= render "devise/shared/error_messages", resource: @user, attribute: :password_confirmation %></div>
        </div>
        <div>
          <div><%= f.label :current_password %></div>
          <div><%= f.password_field :current_password, placeholder: "現在のパスワードを入力", autocomplete: "current-password" %></div>
          <div class="form-error"><%= render "devise/shared/error_messages", resource: @user, attribute: :current_password %></div>
        </div>
        <div class="update-space">
          <div><%= f.submit "更新", class: "btn btn-secondary" %></div>
          <div><%= link_to "キャンセル", :back, class: "btn btn-outline-secondary" %></div>
        </div>
        <div class="delete-space">
          <div><%= link_to "退会する", registration_path(current_user),
            method: :delete,
            data: { confirm: "本当に退会しますか？この操作は取り消せません。" },
            class: "btn btn-danger" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
