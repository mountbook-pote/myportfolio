<% content_for :title, "ユーザー新規登録" %>

<div class="container">
  <div class="default-section sign">
    <h2>ユーザー新規登録</h2>
    <div class="term-space">
      <%= link_to "利用規約", terms_path, class: "link-navy" %>
      <%= link_to "プライバシーポリシー", policy_path, class: "link-navy" %></div>
    <div>
    <div>
      <%= form_for(resource, as: resource_name, 
        url: registration_path(resource_name), 
        html: { class: "form-section" }) do |f| 
      %>
        <div>
          <div>
            <%= f.label :name, "ユーザー名<span class='required-field'>*必須</span>".html_safe %>
          </div>
          <div>
            <%= f.text_field :name, 
              placeholder: "ユーザー名を入力",
              autofocus: true, 
              autocomplete: "name", 
              class: "input" 
            %>
          </div>
          <span class="form-error">
            <%= render "devise/shared/error_messages", 
              resource: @user, attribute: :name 
            %>
          </span>
        </div>

        <div>
          <div>
            <%= f.label :email, "メールアドレス<span class='required-field'>*必須</span>".html_safe %>
          </div>
          <div>
            <%= f.email_field :email, 
              placeholder: "メールアドレスを入力", 
              autocomplete: "email", 
              class: "input"
            %>
          </div>
          <div class="form-error">
            <%= render "devise/shared/error_messages", 
              resource: @user, attribute: :email 
            %>
          </div>
        </div>

        <div>
          <div>
            <%= f.label :password, "パスワード<span class='required-field'>*必須</span>".html_safe %>
            <% if @minimum_password_length %>
            <% end %>
          </div>
          <div>
            <%= f.password_field :password, 
              placeholder: "パスワードを入力", 
              autocomplete: "new-password", 
              class: "input" %>
          </div>
          <div class="form-error">
            <%= render "devise/shared/error_messages", 
              resource: @user, attribute: :password
            %>
          </div>
        </div>

        <div>
          <div>
            <%= f.label :password_confirmation, 
              "確認用パスワード<span class='required-field'>*必須</span>".html_safe 
            %>
          </div>
          <div>
            <%= f.password_field :password_confirmation, 
              placeholder: "確認用パスワードを入力", 
              autocomplete: "new-password", 
              class: "input"
            %>
          </div>
          <div class="form-error">
            <%= render "devise/shared/error_messages", 
              resource: @user, attribute: :password_confirmation
            %>
          </div>
        </div>

        <div class="actions">
          <%= f.submit "新規登録", class: "btn btn-secondary" %>
        </div>
      <% end %>
    </div>

    <div class="login-guestlogin-space">
      <p>
        アカウントをお持ちの方は
        <%= link_to "ログイン", new_user_session_path, class: "link-navy" %>してください。
      </p>
      
      <p>
        アカウントが不要の方は
        <%= link_to "ゲストログイン", users_guest_login_path, method: :post, class: "link-navy" %>してください。
      </p>
    </div>
  </div>
</div>
