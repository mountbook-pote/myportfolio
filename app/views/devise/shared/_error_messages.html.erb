<!-- devise用意のエラー -->
<% if resource.errors.any? %>
    <% if defined?(attribute) && attribute %>
      <% resource.errors.full_messages_for(attribute).each do |message| %>
        <div><%= message %></div>
      <% end %>
    <% else %>
      <% resource.errors.full_messages.each do |message| %>
        <div><%= message %></div>
      <% end %>
    <% end %>
<% end %>
