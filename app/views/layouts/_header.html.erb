<header>
  <div class="header-container">
    <div class="navigationbar__menus">
      <div><%= link_to HomesHelper::APP_TITLE, root_path, class: "app-name" %></div>
      <div><%= link_to "投稿一覧", posts_path, class: "btn btn-light", style:"color: black;" %></div>
      <div><%= link_to "鑑賞", department_path(0), class: "btn btn-light", style:"color: black;" %></div>
     
    </div>

    <div class="navigationbar__users">
      <% if user_signed_in? %>
        <%= render "layouts/navigation_bar", user: user %>
      <% else %>
        <div><%= link_to "ログイン", new_user_session_path, class: "btn btn-light", style:"color: black;" %></div>
        <div><%= link_to "ゲストログイン", users_guest_login_path, method: :post, class: "btn btn-light", style:"color: black;" %></div>
        <div><%= link_to "新規登録", new_user_registration_path, class: "btn btn-primary", style:"color: white;" %></div>
      <% end %>
    </div>
  </div>
</header>
