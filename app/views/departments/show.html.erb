<% content_for :title, ja_translated_name(@department_name) %>

<div class="container">
  <div class="department-selectbox-section">
    <%= render 'shared/department_selectbox' %>
  </div>
  <div class="artworks-section">
    <h2><%= ja_translated_name(@department_name) %></h2>
    <% @met_works.each do |work| %>
      <div>
        <%= link_to work.primary_image_small, target: "_blank", rel: "noopener" do %>
          <img src="<%= work.primary_image_small %>" alt="<%= work.title %>" class="artworks-image">
        <% end %>
      </div>
      <div class="artworks-description-space">
        <h4 class="artworks-description-space__title"><%= work.title %></h4>
        <div class="artworks-description-space__description">
          <div class="artworks-description-space__sentence">
            <% if @department_name == "All Departments" %>
              <div><%= ja_translated_name(work.department) %></div>
            <% end %>
            <div>製作者: <%= work.artist_display_name.presence || '不明' %></div>
            <div>制作年: <%= work.object_date.presence || '不明' %></div>
          </div>
          <div class="artworks-description-space__met">
            <%= link_to work.object_url, target: "_blank", rel: "noopener", class: "link-default" do %>
              <i class="bi bi-bank" title="メトロポリタン美術館で見る"></i>
            <% end %>
          </div>
        </div>
        <div class="artworks-description-space__submit">
          <% if current_user %>
            <p><%= link_to 'この作品を投稿', new_post_path(met_object_id: work.id), class: "post-button" %></p>
          <% else %>
            <p><%= link_to 'この作品を投稿', new_user_session_path(alert: 'アカウント登録もしくはログインしてください') %></p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
  <div class="see-more-section">
    <%= link_to 'もっと見る',request.path, data: { turbolinks: false }, class: "btn btn-light" %>
  </div>
</div>
